# 운영(EC2) 배포 시 infra/.env 로 복사해 채운다. 실제 값은 절대 커밋하지 않는다 (public 레포).
DB_URL=jdbc:postgresql://<rds-endpoint>:5432/platform
DB_USERNAME=
DB_PASSWORD=
# S3 격리 버킷 — 운영은 이미 버킷이 있다고 가정(엔드포인트는 기본 AWS 사용, override 없음).
# 자격증명은 AWS SDK 기본 체인(EC2 IAM 롤)을 쓰므로 여기엔 안 둔다.
QUARANTINE_S3_BUCKET=
QUARANTINE_S3_REGION=
# 이후 단계에서 추가될 값: REDIS_URL, SLACK_WEBHOOK_URL
