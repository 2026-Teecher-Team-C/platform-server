# 로컬 개발 전용 값. 운영 값은 EC2의 infra/.env 에 두고 커밋하지 않는다.
DB_URL=jdbc:postgresql://postgres:5432/platform
DB_USERNAME=platform
DB_PASSWORD=platform
REDIS_HOST=redis
REDIS_PORT=6379
QUARANTINE_S3_BUCKET=platform-quarantine
QUARANTINE_S3_REGION=us-east-1
QUARANTINE_S3_ENDPOINT=http://localstack:4566
QUARANTINE_S3_PATH_STYLE=true
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# 로컬은 localhost:5173 → localhost:8080이 같은 사이트라 SameSite=Lax, HTTP라 Secure를 끈다.
# 운영은 compose.yml 기본값(None / true)을 그대로 쓴다.
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false
# 로컬 전용 초기 관리자. 운영 비밀번호는 EC2의 infra/.env에만 둔다.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=dev-admin-password
